# Public address of this server, origin only (no path, no trailing slash). Also the OIDC redirect base.
PUBLIC_URL=https://valetkey.example.com
# OIDC issuer URL. valetkey reads <issuer>/.well-known/openid-configuration at start.
OIDC_ISSUER=https://accounts.google.com
# Client ID from your identity provider.
OIDC_CLIENT_ID=replace-me
# Client secret from your identity provider.
OIDC_CLIENT_SECRET=replace-me
# Email domains allowed to sign in, comma-separated. Set this, ALLOWED_EMAILS, or both.
ALLOWED_DOMAINS=example.com
# Exact emails allowed to sign in, comma-separated.
# ALLOWED_EMAILS=ana@example.com,ben@example.org
# Set to true if your identity provider omits email_verified (Entra ID does). Default false.
# OIDC_TRUST_UNVERIFIED_EMAIL=false
# Emails that may see every user's activity, comma-separated.
# ADMIN_EMAILS=ana@example.com
# Days to keep the audit log. 0 keeps it forever. Default 90.
# AUDIT_RETENTION_DAYS=90
# Key that seals stored upstream credentials: 64 hex characters or base64 of 32 bytes. Generate: openssl rand -hex 32
VAULT_KEY=replace-with-openssl-rand-hex-32
# Key that signs login sessions, at least 32 characters. Generate: openssl rand -hex 32
SESSION_KEY=replace-with-openssl-rand-hex-32
# Address to listen on. Default :8080.
# ADDR=:8080
# Database. sqlite://./valetkey.db or postgres://user:pass@host:5432/db?sslmode=disable. Default sqlite://./valetkey.db (the image sets sqlite:///data/valetkey.db).
# DATABASE_URL=sqlite://./valetkey.db
# How long an OAuth access token lives. Go duration. Default 1h.
# ACCESS_TOKEN_TTL=1h
# How long an OAuth refresh token lives. Go duration. Default 720h.
# REFRESH_TOKEN_TTL=720h
# How long a sign-in to the web pages lasts. Go duration. Default 12h.
# SESSION_TTL=12h
# JSON file listing other MCP servers to show on the home page. Default catalog.json.
# CATALOG_FILE=catalog.json
# Time zone for log and metric query times written without an offset. The image sets UTC.
# TZ=UTC

# Upstreams. A system is on when its URL is set.
# Jenkins base URL.
# JENKINS_URL=https://jenkins.example.com
# Set to true to skip TLS verification for Jenkins (self-signed certificates).
# JENKINS_INSECURE=false
# Argo CD base URL.
# ARGOCD_URL=https://argocd.example.com
# Set to true to skip TLS verification for Argo CD.
# ARGOCD_INSECURE=false
# Loki API base URL: Loki itself, or a Grafana datasource proxy (https://grafana.example.com/api/datasources/proxy/uid/<uid>).
# LOKI_URL=https://loki.example.com
# Set to true to skip TLS verification for Loki.
# LOKI_INSECURE=false
# Prometheus-compatible API base URL (Prometheus, Mimir, Thanos, VictoriaMetrics), or a Grafana datasource proxy.
# METRICS_URL=https://prometheus.example.com
# Set to true to skip TLS verification for the metrics API.
# METRICS_INSECURE=false
# Bitbucket Cloud API base URL.
# BITBUCKET_URL=https://api.bitbucket.org/2.0
# Set to true to skip TLS verification for Bitbucket.
# BITBUCKET_INSECURE=false
# Notion API base URL. Each user connects with their own Notion personal access token.
# NOTION_URL=https://api.notion.com/v1

# Exact host names of users' MCP servers that may use http and skip the address check (internal servers), comma-separated. Default none.
# UPSTREAM_ALLOW_HOSTS=mcp.internal.example.com
